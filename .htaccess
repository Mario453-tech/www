# Main .htaccess file.

# Force a concrete start file and prevent directory listing.
DirectoryIndex index.php index.html

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Keep authentication cookies on one HTTPS origin.
    RewriteCond %{HTTP_HOST} ^(?:www\.)?oilempire\.pl$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteRule ^ https://oilempire.pl%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^www\.oilempire\.pl$ [NC]
    RewriteRule ^ https://oilempire.pl%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{THE_REQUEST} \s/public/login\.php[\s?]
    RewriteRule ^public/login\.php$ /login [R=301,L]

    # Legacy root PHP entrypoints. They may still exist on FTP because deploy does not delete files.
    RewriteRule ^dashboard\.php$ /dashboard [R=301,L]
    RewriteRule ^hr\.php$ /hr [R=301,L]
    RewriteRule ^technical\.php$ /technical [R=301,L]
    RewriteRule ^boardroom\.php$ /boardroom [R=301,L]
    RewriteRule ^boardroom_status\.php$ /boardroom-status [R=301,L]
    RewriteRule ^profile\.php$ /profile [R=301,L]
    RewriteRule ^dm\.php$ /chat [R=301,L]
    RewriteRule ^chat\.php$ /chat [R=301,L]
    RewriteRule ^login\.php$ /login [R=301,L]
    RewriteRule ^reset_password\.php$ /reset-password [R=301,L]
    RewriteRule ^logistics\.php$ /logistics [R=301,L]
    RewriteRule ^market\.php$ /market [R=301,L]
    RewriteRule ^loans\.php$ /bank [R=301,L]
    RewriteRule ^change_password\.php$ /profile [R=301,L]
    RewriteRule ^(index|technical_check|diag|reset_db|tick|cron-5min|diag_upload|mail_test|db_connection_check|check_files|check_log_cfg|test_db|view_log|dashboard_safe|debug_recruitment)\.php$ / [R=302,L,NE,QSD]

    # Static files without redirect.
    RewriteCond %{REQUEST_URI} ^/v2/
    RewriteRule ^ - [L]

    # Mobile API direct access to PHP files, no redirect.
    RewriteCond %{REQUEST_URI} ^/api/v1/
    RewriteRule ^ - [L]

    # Internal admin implementation and diagnostics are never public pages.
    # Wewnetrzna implementacja admina i diagnostyka nie sa publicznymi stronami.
    RewriteRule ^admin/(AdminLog|db_connection_check|erorr|login_test|market_debug|redirect_diag|tick_test)\.php$ /admin/ [R=302,L,NE,QSD]

    RewriteCond %{REQUEST_URI} ^/assets/ [OR]
    RewriteCond %{REQUEST_URI} ^/admin/ [OR]
    RewriteCond %{REQUEST_URI} ^/public/
    RewriteRule ^ - [L]

    # Browser navigation is not an API call; AJAX still uses authenticated endpoints.
    # Nawigacja przegladarki nie jest API; AJAX nadal uzywa chronionych endpointow.
    RewriteCond %{REQUEST_METHOD} ^GET$
    RewriteCond %{HTTP:Sec-Fetch-Mode} ^navigate$ [OR]
    RewriteCond %{HTTP:Sec-Fetch-Dest} ^document$ [OR]
    RewriteCond %{HTTP_ACCEPT} text/html [NC]
    RewriteRule ^api/internal/ / [R=302,L,NE,QSD]

    # The authenticated HTTP tick remains available for the hosting scheduler.
    # Uwierzytelniony tick HTTP pozostaje dostepny dla harmonogramu hostingu.
    RewriteCond %{REQUEST_URI} ^/cron/tick\.php$
    RewriteRule ^ - [L]

    # Redirect direct requests for implementation and operational directories.
    # Przekieruj bezposrednie zadania do katalogow implementacyjnych i operacyjnych.
    RewriteCond %{REQUEST_URI} ^/(src|config|sql|tests|templates|sessions|tools|migrations|backup|backups|logs|svn_repo|vendor|mobile|serwer|lang|cron|\.claude|\.github|\.githooks|\.phpunit\.cache)(/|$) [NC]
    RewriteRule ^ / [R=302,L,NE,QSD]

    # Clean URLs must stay before the generic root rule.
    # Files in /public/.
    RewriteRule ^change-password$ /profile [R=301,L]
    RewriteRule ^boardroom$       /public/boardroom.php [L,PT]
    RewriteRule ^boardroom-status$ /public/boardroom_status.php [L,PT]
    RewriteRule ^hr$              /public/hr.php [L,PT]
    RewriteRule ^technical$       /public/technical.php [L,PT]
    RewriteRule ^logistics$       /public/logistics.php [L,PT]
    RewriteRule ^dashboard$       /public/dashboard.php [L,PT]
    RewriteRule ^loans$           /bank [R=301,L]
    RewriteRule ^profile$         /public/profile.php [L,PT]
    RewriteRule ^login$           /public/login.php [L,PT]
    RewriteRule ^register$        /public/register.php [L,PT]
    RewriteRule ^bank$            /public/bank.php [L,PT]
    RewriteRule ^wallet-transfer$ /public/wallet_transfer.php [L,PT]
    RewriteRule ^sell$            /public/sell.php [L,PT]
    RewriteRule ^forgot-password$ /public/forgot_password.php [L,PT]
    RewriteRule ^reset-password$  /public/reset_password.php [L,PT]
    RewriteRule ^language$        /public/language.php [L,PT]
    RewriteRule ^logout$          /public/logout.php [L,PT]
    RewriteRule ^mobile-bridge-login$ /public/mobile_bridge_login.php [L,PT]
    RewriteRule ^map$             /public/map.php [L,PT]
    RewriteRule ^market$          /public/market.php [L,PT]
    RewriteRule ^market-offers$   /public/market_offers.php [L,PT]
    RewriteRule ^recovery$        /public/recovery.php [L,PT]
    RewriteRule ^upgrade-storage$ /public/upgrade_storage.php [L,PT]
    RewriteRule ^upgrade-well$    /public/upgrade_well.php [L,PT]
    RewriteRule ^help$            /public/help.php [L,PT]
    RewriteRule ^verify-email$              /public/verify_email.php [L,PT]
    RewriteRule ^newsletter-unsubscribe$    /public/newsletter_unsubscribe.php [L,PT]

    RewriteRule ^chat$           /public/chat.php [L,PT]
    RewriteRule ^dm$             /public/dm.php [L,PT]
    RewriteRule ^sabotage$       /public/sabotage.php [L,PT]
    RewriteRule ^finance$        /public/finance.php [L,PT]
    RewriteRule ^legal$          /public/legal.php [L,PT]
    RewriteRule ^contracts$      /public/contracts.php [L,PT]
    RewriteRule ^diag-upload$    /diag_upload.php [L,PT]

# BEGIN static_pages
    RewriteRule ^regulamin$ /public/page.php?slug=regulamin [L,QSA]
# END static_pages

    # Root request goes to public index.
    RewriteRule ^$ /public/index.php [L]

    # No fallback: unknown URLs return the default 404.
</IfModule>

# Block sensitive files.
<FilesMatch "\.(sql|log|md|env|git|sh|bak)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(\.htaccess|\.gitignore|\.env|debug\.log|debug_log\.php|check_files\.php|test_db\.php|view_log\.php|dashboard_safe\.php|debug_recruitment\.php|cron-5min\.php)$">
    Require all denied
</FilesMatch>

# Security headers.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json
</IfModule>

# Cache.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg        "access plus 1 month"
    ExpiresByType image/png         "access plus 1 month"
    ExpiresByType image/gif         "access plus 1 month"
    ExpiresByType image/webp        "access plus 1 month"
    # CSS/JS have ?v=filemtime in URL, so browsers fetch new versions when URLs change.
    ExpiresByType text/css          "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/html         "access plus 0 seconds"
</IfModule>

# PHP pages (HTML) always revalidate and are never served from cache.
<IfModule mod_headers.c>
    <FilesMatch "\.php$">
        Header always set Cache-Control "no-cache, must-revalidate"
        Header always set Pragma "no-cache"
    </FilesMatch>
</IfModule>
